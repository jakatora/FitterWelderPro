<?xml version="1.0" encoding="utf-8"?>
<!--
    Kopia w chmurze i przenosiny telefon-telefon (Android 12+,
    android:dataExtractionRules). Uzasadnienie w backup_rules.xml - obie
    listy musza mowic to samo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="sharedpref" path="scheduled_notifications.xml" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="sharedpref" path="scheduled_notifications.xml" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
