<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>pl</string>
		<string>en</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>FitterWelder Pro</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>FitterWelderPro</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>FitterWelder Pro uses your photo library to attach images to welding projects and pipe spool documentation.</string>
	<key>NSCameraUsageDescription</key>
	<string>Aparat służy do zrobienia zdjęcia numeru wytopu (heat) lub atestu materiału, które dołączasz do projektu. / The camera is used to photograph a heat number or material certificate that you attach to the project.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Mikrofon służy do dyktowania poleceń asystentowi (np. zapis parametru spawania) i włącza się tylko po naciśnięciu przycisku. / The microphone is used to dictate commands to the assistant (e.g. saving a welding parameter) and turns on only when you tap the button.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Rozpoznawanie mowy zamienia podyktowane polecenie na tekst, który widzisz i możesz poprawić przed zapisem. / Speech recognition turns your dictated command into text you can see and edit before anything is saved.</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
